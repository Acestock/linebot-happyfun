// Prisma schema — see docs/ARCHITECTURE.md 第 3 節 ER 圖
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameSessionStatus {
  pending
  active
  finished
  cancelled
  timeout
}

enum MeetupPhase {
  SETUP
  READY
  OPENING
  CHECKIN
  ICEBREAKER
  INTERACTION
  FREE_TALK
  CLOSING
  ENDED
  PAUSED
  CANCELLED
}

model Group {
  id               String    @id @default(uuid())
  lineGroupId      String    @unique @map("line_group_id")
  displayName      String?   @map("display_name")
  personaStyle     String    @default("energetic_roast") @map("persona_style")
  joinedAt         DateTime  @default(now()) @map("joined_at")
  isActive         Boolean   @default(true) @map("is_active")
  memoryClearedAt  DateTime? @map("memory_cleared_at")

  members          GroupMember[]
  memories         GroupMemory[]
  gameSessions     GameSession[]
  meetups          Meetup[]
  wordleAttempts   WordleAttempt[]
  oneATwoBAttempts OneATwoBAttempt[]

  @@map("groups")
}

model GroupMember {
  id                String   @id @default(uuid())
  groupId           String   @map("group_id")
  lineUserId        String   @map("line_user_id")
  displayName       String?  @map("display_name")
  firstSeenAt       DateTime @default(now()) @map("first_seen_at")
  lastInteractedAt  DateTime @default(now()) @map("last_interacted_at")
  messageCount      Int      @default(0) @map("message_count")

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants GameParticipant[]
  moves        GameMove[]
  wonSessions  GameSession[]     @relation("SessionWinner")
  startedSessions GameSession[]  @relation("SessionStarter")
  hostedMeetups   Meetup[]          @relation("MeetupHost")
  meetupCheckins  MeetupCheckin[]
  meetupFeedbacks MeetupFeedback[]
  wordleAttempts  WordleAttempt[]
  oneATwoBAttempts OneATwoBAttempt[]

  @@unique([groupId, lineUserId])
  @@map("group_members")
}

model GroupMemory {
  id         String   @id @default(uuid())
  groupId    String   @map("group_id")
  memoryType String   @map("memory_type")
  key        String
  value      Json
  weight     Float    @default(1.0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, memoryType, key])
  @@map("group_memory")
}

model GameSession {
  id                 String            @id @default(uuid())
  groupId            String            @map("group_id")
  gameType           String            @map("game_type")
  status             GameSessionStatus @default(pending)
  config             Json
  startedAt          DateTime          @default(now()) @map("started_at")
  endedAt            DateTime?         @map("ended_at")
  winnerMemberId     String?           @map("winner_member_id")
  startedByMemberId  String?           @map("started_by_member_id")

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  winner       GroupMember?      @relation("SessionWinner", fields: [winnerMemberId], references: [id])
  starter      GroupMember?      @relation("SessionStarter", fields: [startedByMemberId], references: [id])
  participants GameParticipant[]
  moves        GameMove[]

  @@index([groupId, status])
  @@map("game_sessions")
}

model GameParticipant {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  memberId      String   @map("member_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  rank          Int?
  guessesCount  Int      @default(0) @map("guesses_count")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@map("game_participants")
}

model GameMove {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  memberId   String   @map("member_id")
  moveIndex  Int      @map("move_index")
  payload    Json
  result     Json
  createdAt  DateTime @default(now()) @map("created_at")

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("game_moves")
}

/// 小聚活動主持人 — 跟 game_sessions 刻意分開的平行資料模型：
/// 小聚是主辦人驅動的長時間活動流程，不是輸贏遊戲，狀態機/權限/簽到的語意都不同，
/// 硬塞進 GameSession 會讓兩邊互相污染。狀態直接落地 Postgres（不像遊戲用 Redis
/// 存活躍狀態），因為小聚動輒 30~90 分鐘，不適合套用遊戲那套短時效 TTL。
model Meetup {
  id                   String       @id @default(uuid())
  groupId              String       @map("group_id")
  hostMemberId         String       @map("host_member_id")
  phase                MeetupPhase  @default(SETUP)
  pausedFromPhase      MeetupPhase? @map("paused_from_phase")

  name                 String?
  plannedMinutes       Int?         @map("planned_minutes")
  hostStyle            String?      @map("host_style")
  icebreakerCategory   String?      @map("icebreaker_category")
  interactionType      String?      @map("interaction_type")
  customIcebreakerText String?      @map("custom_icebreaker_text")

  /// SETUP 精靈目前在等哪一題的回答（name/time/customTime/style/icebreaker/interaction），完成後清為 null
  setupStep            String?      @map("setup_step")

  currentIcebreaker    String?      @map("current_icebreaker")
  usedIcebreakers      Json         @default("[]") @map("used_icebreakers")

  currentInteraction   String?      @map("current_interaction")
  usedInteractions     Json         @default("[]") @map("used_interactions")

  /// 活動進行中（非 SETUP/READY/PAUSED/結束）每位成員的發言則數，key 是 GroupMember.id。
  /// 不逐則回覆，純粹統計用，結束時做成報告卡的「熱度」與「最活躍」欄位。
  messageCounts        Json         @default("{}") @map("message_counts")

  createdAt            DateTime     @default(now()) @map("created_at")
  /// 每次 update() 都會自動刷新，閒置逾時排程用它判斷主辦人是不是忘了收尾
  lastActivityAt        DateTime    @default(now()) @updatedAt @map("last_activity_at")
  startedAt            DateTime?    @map("started_at")
  endedAt              DateTime?    @map("ended_at")

  /// 進入目前這個階段的時間點（推進/跳過/繼續時重設），排程用它算「這階段還剩多少預計時間」
  phaseStartedAt       DateTime?    @map("phase_started_at")
  /// 這個階段的「時間快到了」提醒是否已經發過，避免同一階段重複推播
  phaseReminderSent    Boolean      @default(false) @map("phase_reminder_sent")

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  host      GroupMember      @relation("MeetupHost", fields: [hostMemberId], references: [id])
  checkins  MeetupCheckin[]
  feedbacks MeetupFeedback[]

  @@index([groupId, phase])
  @@map("meetups")
}

model MeetupCheckin {
  id          String   @id @default(uuid())
  meetupId    String   @map("meetup_id")
  memberId    String   @map("member_id")
  text        String?
  checkedInAt DateTime @default(now()) @map("checked_in_at")

  meetup Meetup      @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetupId, memberId])
  @@map("meetup_checkins")
}

model MeetupFeedback {
  id        String   @id @default(uuid())
  meetupId  String   @map("meetup_id")
  memberId  String   @map("member_id")
  feedback  String
  createdAt DateTime @default(now()) @map("created_at")

  meetup Meetup      @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([meetupId, memberId])
  @@map("meetup_feedback")
}

/// LIFF 每日 Wordle — 跟 game_sessions 一樣是刻意分開的平行資料模型：
/// 每個玩家各自獨立解題（不是共用一份 Redis 狀態的輪流猜謎），且狀態要跨天保留
/// 做排行榜，不適合套用遊戲引擎「一個群組同時只有一場、Redis TTL 到就消失」那套機制。
model WordlePuzzle {
  id        String   @id @default(uuid())
  /// 台灣時區的日期字串（例如 "2026-07-16"），全部群組共用同一題，每天一題
  date      String   @unique
  answer    String
  createdAt DateTime @default(now()) @map("created_at")

  attempts WordleAttempt[]

  @@map("wordle_puzzles")
}

model WordleAttempt {
  id         String    @id @default(uuid())
  puzzleId   String    @map("puzzle_id")
  /// 跟 group_sessions/meetups 同樣的作法：groupId 直接落欄位，排行榜查詢不用多 join
  groupId    String    @map("group_id")
  memberId   String    @map("member_id")
  /// 依序猜過的單字，例如 ["CRANE", "SLATE"]；每個字母的顏色回饋是 answer+guess 的
  /// 純函式運算結果，不落地儲存，避免重複維護衍生資料
  guesses    Json      @default("[]")
  solved     Boolean   @default(false)
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  createdAt  DateTime  @default(now()) @map("created_at")

  puzzle WordlePuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  group  Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member GroupMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([puzzleId, memberId])
  @@index([puzzleId, groupId])
  @@map("wordle_attempts")
}

/// LIFF 每日 1A2B（猜數字密碼）— 跟 WordlePuzzle/WordleAttempt 完全同樣的形狀與理由：
/// 每個玩家各自獨立解題、狀態要跨天留著算排行榜，是自己一套平行資料模型。
model OneATwoBPuzzle {
  id        String   @id @default(uuid())
  /// 台灣時區的日期字串（例如 "2026-07-16"），全部群組共用同一題，每天一題
  date      String   @unique
  /// 4 位不重複數字組成的密碼，例如 "1234"
  answer    String
  createdAt DateTime @default(now()) @map("created_at")

  attempts OneATwoBAttempt[]

  @@map("one_a_two_b_puzzles")
}

model OneATwoBAttempt {
  id         String    @id @default(uuid())
  puzzleId   String    @map("puzzle_id")
  groupId    String    @map("group_id")
  memberId   String    @map("member_id")
  /// 依序猜過的號碼，例如 ["5678", "1243"]；每一位數字的顏色回饋（A/B/沒中）是
  /// answer+guess 的純函式運算結果，不落地儲存
  guesses    Json      @default("[]")
  solved     Boolean   @default(false)
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")
  createdAt  DateTime  @default(now()) @map("created_at")

  puzzle OneATwoBPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member GroupMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([puzzleId, memberId])
  @@index([puzzleId, groupId])
  @@map("one_a_two_b_attempts")
}
