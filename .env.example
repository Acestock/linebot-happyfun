# === LINE Developers Console ===
# LINE Developers Console > Messaging API channel > Channel access token (long-lived)
# Railway: 手動填入 Variables
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Developers Console > Messaging API channel > Basic settings > Channel secret
# Railway: 手動填入 Variables
LINE_CHANNEL_SECRET=

# === Database / Redis ===
# 本機：指向 docker-compose 起的 Postgres
# Railway：由 Postgres Plugin 自動注入，不需要手動填
DATABASE_URL=postgresql://linebot:linebot@localhost:5432/linebot

# 本機：指向 docker-compose 起的 Redis
# Railway：由 Redis Plugin 自動注入，不需要手動填
REDIS_URL=redis://localhost:6379

# === LLM (AI 主持人文案生成) ===
# Railway: OPENAI_API_KEY 手動填入 Variables；沒填時自動使用寫死的預設文案（降級模式）
# LLM_PROVIDER / LLM_MODEL 有預設值（openai / gpt-4o），不改可以不填
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
# 之後想換回 Claude 時使用（LLM_PROVIDER=anthropic）
ANTHROPIC_API_KEY=

# === 排程 / 成本控制參數（皆有預設值，需要調整才需要設定）===
# Railway: 視需求手動填入 Variables，不填則吃程式內建預設值
PUSH_RATE_LIMIT_PER_GROUP_PER_HOUR=2
# 閒置主動互動預設關閉（一切互動由 party 觸發）；要開啟設為 true
IDLE_NUDGE_ENABLED=false
IDLE_NUDGE_THRESHOLD_MINUTES=180
IDLE_NUDGE_SWEEP_INTERVAL_MINUTES=30
GAME_TIMEOUT_MINUTES=10
GAME_TIMEOUT_SWEEP_INTERVAL_MINUTES=2
# 小聚閒置逾時預設開啟（可靠度保險絲，不是行銷推播）：主辦人這麼多分鐘沒操作就自動收攤
MEETUP_IDLE_TIMEOUT_ENABLED=true
MEETUP_IDLE_TIMEOUT_MINUTES=180
MEETUP_IDLE_SWEEP_INTERVAL_MINUTES=15
# 小聚各階段時間快到時提醒主辦人（只提醒，不自動推進流程），預設開啟
MEETUP_PHASE_REMINDER_ENABLED=true
MEETUP_PHASE_REMINDER_LEAD_MINUTES=5
MEETUP_PHASE_REMINDER_SWEEP_INTERVAL_MINUTES=5
# 大老二棄局保護：LOBBY 太久沒開局／PLAYING 太久沒人動作就自動取消，避免卡住「一個群組
# 只能開一團」的名額
BIG_TWO_LOBBY_ABANDON_MINUTES=15
BIG_TWO_PLAYING_ABANDON_MINUTES=20
BIG_TWO_ABANDON_SWEEP_INTERVAL_MINUTES=5

# === 其他 ===
# 保護 /internal/stats 這類內部統計 endpoint 用的 token（Phase 4+ 使用）
# Railway: 手動填入 Variables
INTERNAL_STATS_TOKEN=
# 沒有本機／CLI 可以連正式環境資料庫時的最後手段：設了這個值，GET
# /internal/migrate-resolve?token=<這裡的值>&migration=<migration資料夾名稱> 就能直接
# 用瀏覽器修復卡住的 migration（沒設就完全不存在這條路，回 404）。修完建議刪掉這個變數。
MIGRATE_RESOLVE_TOKEN=

# LIFF app ID（每日 Wordle 小遊戲用）。注意：LINE 現在不能把 LIFF app 掛在 Messaging API
# channel（就是「派對小子」這個 channel）底下，要另外在同一個 Provider 底下建立一個
# LINE Login channel，LIFF app 是建在那個 channel 的「LIFF」分頁裡：
#   1. LINE Developers Console > 選跟 Messaging API channel 同一個 Provider
#   2. Create a new channel > LINE Login（不要新建 Provider，維持同一個）
#   3. 進入這個新 channel 的 LIFF 分頁 > Add，Endpoint URL 填 https://<你的網域>/liff/，
#      Scope 記得勾 openid（拿 ID token 用）
#   4. 建立完成後顯示的 LIFF ID 就是這裡要填的值
# Railway: 手動填入 Variables
LIFF_ID=

# 上面那個 LINE Login channel 的 Channel ID（數字，在該 channel 的 Basic settings 分頁，
# 不是 Messaging API channel 的 Channel secret）：驗證 LIFF ID token 時當 client_id 用
# ⚠️ 常見填錯：這裡要填「純數字」，不是 https://liff.line.me/xxxxxxxxxx-yyyyyyyy 整串網址。
# LIFF ID 格式其實就是「{Channel ID}-{隨機字串}」，網址裡 liff.line.me/ 後面、第一個
# "-" 之前那段數字就是 Channel ID，可以直接拿來填，不用另外去 Basic settings 分頁查。
# 填錯會導致 LIFF 頁面打得開，但呼叫 API 時一直卡在「身分驗證失敗」。
# Railway: 手動填入 Variables
LIFF_CHANNEL_ID=

# LIFF app ID（每日 1A2B 猜數字小遊戲用）。一個 LIFF app 只能對應一個固定網址，
# 所以每個 LIFF 網頁小遊戲都要在同一個 LINE Login channel（上面 LIFF_ID 那個）底下
# 「再加一個」LIFF app，不用另外建 channel、也不用重填 LIFF_CHANNEL_ID：
#   1. 進到同一個 LINE Login channel 的 LIFF 分頁 > Add
#   2. Endpoint URL 填 https://<你的網域>/liff/one-a-two-b/，Scope 一樣勾 openid
#   3. 建立完成後顯示的完整 LIFF ID（含後面的隨機字串）填在這裡，這個值本身就是完整 ID，
#      跟 LIFF_ID 那格填法一樣——只有 LIFF_CHANNEL_ID 那格才要拿前綴數字
# Railway: 手動填入 Variables
LIFF_ID_ONE_A_TWO_B=

# LIFF app ID（大老二人機混合對戰用）。申請方式跟上面 LIFF_ID_ONE_A_TWO_B 完全一樣，
# 一樣在同一個 LINE Login channel 的 LIFF 分頁 > Add，Endpoint URL 填
# https://<你的網域>/liff/big-two/，Scope 勾 openid，把完整 LIFF ID 填在這裡
# Railway: 手動填入 Variables
LIFF_ID_BIG_TWO=

# Node 環境與埠號
# Railway: 不需要手動填，Railway 會自動提供 PORT；NODE_ENV 建議手動設為 production
NODE_ENV=development
PORT=3000
